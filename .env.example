PORT=8000
PYTHONPATH=/app/backend
PROJECT_ROOT=/app
DATA_ROOT=/tmp/data

ARTIFACT_STORE_BACKEND=mongodb
MONGODB_URI=
MONGODB_DATABASE=healthlens_artifacts
MONGODB_GRIDFS_BUCKET=artifact_files
RESTORE_ARTIFACTS_ON_STARTUP=true
ARTIFACT_RESTORE_MODE=background
ARTIFACT_RELEASE=v0.6-chemical-explorer
RESTORE_WORKSPACE_DIR=/tmp/restore

VECTOR_BACKEND=pinecone
PINECONE_API_KEY=
PINECONE_INDEX=healthlens-knowledge
PINECONE_NAMESPACE=production
PINECONE_DIMENSION=768
PINECONE_METRIC=cosine

NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

LLM_PROVIDER=ollama
OLLAMA_ENABLED=true
OLLAMA_HOST=
OLLAMA_API_KEY=
OLLAMA_MODEL=<verified-model>

AWS_LWA_ASYNC_INIT=true
AWS_LWA_PORT=8000
AWS_LWA_READINESS_CHECK_PATH=/
